# Copia in .env e compila. .env NON va committato (e' nel .gitignore).
DB_URL=jdbc:postgresql://localhost:5432/salone
DB_USERNAME=postgres
DB_PASSWORD=

# Almeno 32 caratteri casuali
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60

ADMIN_EMAIL=
ADMIN_PASSWORD=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
FRONTEND_URL=http://localhost:5173

# Gmail: account + "password per le app" (Account Google > Sicurezza > Verifica in due passaggi > Password per le app)
MAIL_ENABLED=false
MAIL_USERNAME=
MAIL_PASSWORD=
